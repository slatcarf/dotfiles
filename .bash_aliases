
alias tt="tt -highlight1"
alias tty-clock="tty-clock -c -C 4 -f %d.%m.%y"
alias srk="racket -I simply-scheme -r"
alias sims="racket -I simply-scheme"
alias dush="du -sh ./* | sort -h"
alias formatfix="pnpm format && git add . && git commit -m 'chore: formatting' && git push"
alias ip='ip --color=auto'
alias ls='ls --color=auto'
alias df='df -PTh -x tmpfs -x devtmpfs -x squashfs -x overlay'
alias rm=trash
alias xcp="xclip -sel clipboard"
