alias dush="du -sh ./* | sort -h"
alias formatfix="pnpm format && git add . && git commit -m 'chore: formatting' && git push"
alias ip='ip --color=auto'
alias ls='ls --color=auto'
alias df='df -PTh -x tmpfs -x devtmpfs -x squashfs -x overlay'
alias rm=trash
alias xcp="xclip -sel clipboard"

function zathura() {
  nohup zathura "$1" >/dev/null &
  exit
}

zmv() {
  if [ "$#" -ne 2 ]; then
    echo "Usage: zmv <source> <z pattern>"
    return 1
  fi

  local target_dir
  target_dir=$(z -e "$2")

  if [ -z "$target_dir" ]; then
    echo "Error: No match found for '$2' using 'z'."
    return 1
  fi

  mv "$1" "$target_dir"
}

_zmv_complete_source() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  COMPREPLY=($(compgen -f -- "$cur")) # File and directory completion
}
complete -F _zmv_complete_source zmv

export EDITOR=vim
export VISUAL=vim
